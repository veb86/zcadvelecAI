        <UnitName Value="uzedwgtext"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgtypes.pas"/>
        <UnitName Value="uzedwgtypes"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgdiagnostics.pas"/>
        <UnitName Value="uzedwgdiagnostics"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgresolver.pas"/>
        <UnitName Value="uzedwgresolver"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgloadcontext.pas"/>
        <UnitName Value="uzedwgloadcontext"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgblocks.pas"/>
        <UnitName Value="uzedwgblocks"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgtables.pas"/>
        <UnitName Value="uzedwgtables"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgentityregistry.pas"/>
        <UnitName Value="uzedwgentityregistry"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgfinalize.pas"/>
        <UnitName Value="uzedwgfinalize"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgimport.pas"/>
        <UnitName Value="uzedwgimport"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\uzedwgrawscan.pas"/>
        <UnitName Value="uzedwgrawscan"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\entities\uzedwgentline.pas"/>
