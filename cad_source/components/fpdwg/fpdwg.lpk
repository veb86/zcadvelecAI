<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="fpdwg"/>
    <Type Value="RunAndDesignTime"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Files>
      <Item>
        <Filename Value="dwg.pp"/>
        <UnitName Value="dwg"/>
      </Item>
      <Item>
        <Filename Value="dwgproc.pp"/>
        <UnitName Value="dwgproc"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_types.pp"/>
        <UnitName Value="fpdwg_types"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_logger.pp"/>
        <UnitName Value="fpdwg_logger"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_libredwg_utils.pp"/>
        <UnitName Value="fpdwg_libredwg_utils"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_reader.pp"/>
        <UnitName Value="fpdwg_reader"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_filter.pp"/>
        <UnitName Value="fpdwg_filter"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_factory.pp"/>
        <UnitName Value="fpdwg_factory"/>
      </Item>
      <Item>
        <Filename Value="inspector\model\fpdwg_model_base.pp"/>
        <UnitName Value="fpdwg_model_base"/>
      </Item>
      <Item>
        <Filename Value="inspector\model\fpdwg_model_tables.pp"/>
        <UnitName Value="fpdwg_model_tables"/>
      </Item>
      <Item>
        <Filename Value="inspector\model\fpdwg_model_blocks.pp"/>
        <UnitName Value="fpdwg_model_blocks"/>
      </Item>
      <Item>
        <Filename Value="inspector\model\fpdwg_model_entities.pp"/>
        <UnitName Value="fpdwg_model_entities"/>
      </Item>
      <Item>
        <Filename Value="inspector\model\fpdwg_model_unknown.pp"/>
        <UnitName Value="fpdwg_model_unknown"/>
      </Item>
      <Item>
        <Filename Value="inspector\mappers\fpdwg_map_unknown.pp"/>
        <UnitName Value="fpdwg_map_unknown"/>
      </Item>
      <Item>
        <Filename Value="inspector\mappers\fpdwg_map_layer.pp"/>
        <UnitName Value="fpdwg_map_layer"/>
      </Item>
      <Item>
        <Filename Value="inspector\mappers\fpdwg_map_linetype.pp"/>
        <UnitName Value="fpdwg_map_linetype"/>
      </Item>
      <Item>
        <Filename Value="inspector\mappers\fpdwg_map_block.pp"/>
        <UnitName Value="fpdwg_map_block"/>
      </Item>
      <Item>
        <Filename Value="inspector\mappers\fpdwg_map_line.pp"/>
        <UnitName Value="fpdwg_map_line"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_registry.pp"/>
        <UnitName Value="fpdwg_registry"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_document.pp"/>
        <UnitName Value="fpdwg_document"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_resolver.pp"/>
        <UnitName Value="fpdwg_resolver"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_validator.pp"/>
        <UnitName Value="fpdwg_validator"/>
      </Item>
      <Item>
        <Filename Value="inspector\fpdwg_reporter.pp"/>
        <UnitName Value="fpdwg_reporter"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
