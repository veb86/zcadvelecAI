      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\entities\uzedwgentarc.pas"/>
        <UnitName Value="uzedwgentarc"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\entities\uzedwgentpoint.pas"/>
        <UnitName Value="uzedwgentpoint"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\entities\uzedwgentlwpolyline.pas"/>
        <UnitName Value="uzedwgentlwpolyline"/>
      </Item>
      <Item>
        <Filename Value="..\..\zengine\fileformats\dwg\entities\uzedwgenttext.pas"/>
